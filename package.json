{
  "name": "moba-core",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit",
    "lint": "eslint .",
    "check:deps": "node tools/check-deps.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "validate:content": "node tools/validate-content.mjs",
    "test:unit": "vitest run tests/unit tests/architecture",
    "test:sim": "vitest run tests/simulation tests/replay",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build",
    "check": "node tools/check.mjs",
    "probe:software": "npm run build && node tools/run-software-probe.mjs",
    "package": "python3 tools/package-project.py"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "3.2.4",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "typescript-eslint": "8.48.1",
    "@types/node": "24.10.1",
    "@playwright/test": "1.56.1"
  }
}
